datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Team {
  id           String    @id
  teamName     String
  score        Int       @default(0)
  cardsCaught  String[]  @default([])
  lastCaughtAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("teams")
}

model Card {
  id            String   @id
  name          String
  value         Int      @default(8)
  tier          String   @default("Common")
  image         String   @default("")
  question      String   @default("")
  options       String[] @default([])
  correctAnswer Int      @default(0)
  mindFile      String   @default("")
  modelUrl      String   @default("")
  isCaught      Boolean  @default(false)
  caughtByTeam  String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  targetIndex   Int?

  @@map("cards")
}

model Counter {
  name      String   @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@map("counters")
}
